		(exclude_from_sim no)
		(at 83.82 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "61575935-8015-4e06-9dfe-b228a5f0c3a8")
	)
	(text "(*) Depends on voltage\n\n         LV(15-0-15V)  HV(21-0-21V)        Phantom(48V)\nR2       3K3           5K6                 9K1\nR3       6R2           omit\nR4       12R           omit\nR5       2K7           8K2                 9K1\nR6       omit          3K3                 6K2\nR15      Linked out    2R2/2.5W            10R/0.5W\nR16      Linked out    10R                 10R\nRV1      omit          10K                 5K\nRV2      Can be linked out if R9/R10 are well matched\nC1,C2    1000-2200/50V 1000uF/63V          220uF/100V\nC3       ------------- 10-100uF/50V --------------\nC5,C6    470nF         470nF               10uF/63V\nC7,C8    470uF/>30V    220uF/>42V\nD1-D4    1N4002/SB40   1N4004              1N4004\nD5,D6    1N4002        ZY24(24V/2W Zener)  ZY24(24V/2W Zener)  \nTR1      BC337         omit                omit\nPTC1     0.5A          0.5A                170mA\n\nInput    28V/140mA     18-0-18/15VA        24-0-24/15VA\n         25V/15VA\n\n\n(-) In case of instability\nL1,R13 can normally be linked out (used with ultra-low ESR polymer caps for C7,C8)\n"
		(exclude_from_sim no)
		(at 163.83 55.245 0)
		(effects
			(font
				(face "DejaVu Sans Mono")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "8e273a6c-7482-428b-afbf-688280b8e0cc")
	)
